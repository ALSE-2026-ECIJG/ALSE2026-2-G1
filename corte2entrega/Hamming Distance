#pragma once
#include <string>
#include <stdexcept>
namespace hamming {
int compute(const std::string& a, const std::string& b) {
    if (a.size() != b.size()) {
        throw std::invalid_argument("Las cadenas deben tener la misma longitud");
    }
    int distancia = 0;
    for (std::size_t i = 0; i < a.size(); i++) {
        if (a[i] != b[i]) {
            distancia++;
        }
    }
    return distancia;
}
}
