#include <vector>
#include <algorithm>
using namespace std;
class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int minimo = prices[0];
        int mejorGanancia = 0;
        for (int i = 1; i < prices.size(); i++) {
            int ganancia = prices[i] - minimo;
            mejorGanancia = max(mejorGanancia, ganancia);
            minimo = min(minimo, prices[i]);
        }
        return mejorGanancia;
    }
};
